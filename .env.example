# ============================================================
# PolicyPilot – Environment Configuration
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit a real .env file to version control.
# ============================================================

# --- Backend ---
APP_NAME=PolicyPilot
APP_VERSION=0.1.0
DEBUG=false

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# Document storage directories (relative to backend or absolute)
DOCUMENTS_DIR=data/documents
METADATA_DIR=data/metadata
CHUNKS_DIR=data/chunks

# Maximum upload size in bytes (default 10 MB = 10485760)
MAX_UPLOAD_SIZE_BYTES=10485760

# Chunking configuration (in characters)
TARGET_CHUNK_SIZE=1000
CHUNK_OVERLAP=150


# --- Frontend ---
# Backend API URL used by the Next.js frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Future: AI / Embedding providers (Phase 2+) ---
# OPENAI_API_KEY=your-key-here
# GEMINI_API_KEY=your-key-here
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
