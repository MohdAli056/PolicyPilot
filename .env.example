# ============================================================
# PolicyPilot – Environment Configuration
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit a real .env file to version control.
# ============================================================

# --- Backend ---
APP_NAME=PolicyPilot
APP_VERSION=0.1.0
DEBUG=false

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# Document storage directories (relative to backend or absolute)
DOCUMENTS_DIR=data/documents
METADATA_DIR=data/metadata
CHUNKS_DIR=data/chunks

# Maximum upload size in bytes (default 10 MB = 10485760)
MAX_UPLOAD_SIZE_BYTES=10485760

# Chunking configuration (in characters)
TARGET_CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Qdrant Vector Database configuration
# Set QDRANT_PATH for embedded local mode (default), or QDRANT_URL for a remote/container instance
QDRANT_PATH=data/qdrant
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION=policypilot_chunks

# Embedding provider configuration ("fastembed" or "mock")
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

# Search limits
DEFAULT_SEARCH_LIMIT=5
MAX_SEARCH_LIMIT=50


# --- Frontend ---
# Backend API URL used by the Next.js frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
